# finRAG 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ── DeepSeek API（专业模式） ───────────────
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Ollama（安全模式，可选项） ─────────────
SAFE_LLM_BASE_URL=http://host.docker.internal:11434
SAFE_LLM_MODEL=qwen2.5:7b

# ── Qdrant（默认使用 docker-compose 中定义的 qdrant 服务） ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_MODE=remote

# ── Embedding 模型（首次启动自动下载，仅 ~21MB） ──
EMBED_MODEL_PATH=BAAI/bge-small-zh-v1.5

# ── 预算控制（可选，默认值见 backend/config.py） ──
DAILY_BUDGET_YUAN=50
ALL_TIME_BUDGET_YUAN=200
SESSION_BUDGET_YUAN=5
REQUEST_BUDGET_YUAN=1
BUDGET_DEGRADE=cache_only
